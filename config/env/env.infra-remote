# Environment configuration for remote server deployment
# Uses IP addresses and exposed ports for service discovery

# Remote Server Configuration
INFRA_SERVER_IP=10.40.30.161

# Data Stores
MONGODB_HOST=${INFRA_SERVER_IP}
MONGODB_PORT=20017
REDIS_HOST=${INFRA_SERVER_IP}
REDIS_PORT=20379

# Messaging
KAFKA_BROKERS=${INFRA_SERVER_IP}:20092

# Service Discovery
CONSUL_HOST=${INFRA_SERVER_IP}
CONSUL_PORT=20500

# Observability - OTLP Endpoints
ALLOY_OTLP_GRPC=${INFRA_SERVER_IP}:24327
ALLOY_OTLP_HTTP=${INFRA_SERVER_IP}:24328

# Observability - Backend URLs
LOKI_URL=http://${INFRA_SERVER_IP}:23100
TEMPO_URL=http://${INFRA_SERVER_IP}:24317
MIMIR_URL=http://${INFRA_SERVER_IP}:23009
PROMETHEUS_URL=http://${INFRA_SERVER_IP}:23090
GRAFANA_URL=http://${INFRA_SERVER_IP}:23000

# Object Storage
MINIO_ENDPOINT=${INFRA_SERVER_IP}:20000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Application Services (still local)
CONFIG_SERVER_URL=http://config-server:8888
CONFIG_CONTROL_URL=http://config-control-service:8080

# Keycloak Configuration (Production)
# Keycloak Public URL - browser-accessible URL for Swagger UI OAuth2
KEYCLOAK_PUBLIC_URL=http://${INFRA_SERVER_IP}:28080
# Keycloak Issuer URI - for Spring Security OAuth2 Resource Server
KEYCLOAK_ISSUER_URI=http://${INFRA_SERVER_IP}:28080/realms/config-control
# Keycloak Internal URL - for service-to-service communication (always use Docker service name)
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
# Keycloak Frontend URL - URL where admin-dashboard is accessible (for redirects and cookies)
KEYCLOAK_FRONTEND_URL=http://${INFRA_SERVER_IP}:3000
# Swagger UI OAuth2 redirect URL
SWAGGER_OAUTH2_REDIRECT_URL=http://${INFRA_SERVER_IP}:28081/swagger-ui/oauth2-redirect.html
# Keycloak Hostname - optional, leave empty to use X-Forwarded-Host from proxy
KEYCLOAK_HOSTNAME=
