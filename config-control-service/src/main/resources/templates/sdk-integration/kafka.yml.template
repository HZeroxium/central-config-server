# Kafka Configuration Template
# This template provides a common pattern for Kafka configuration

kafka:
  bootstrap-servers: ${KAFKA_BOOTSTRAP_SERVERS:localhost:9092}
  consumer:
    group-id: ${KAFKA_CONSUMER_GROUP_ID:my-group}
    auto-offset-reset: earliest
    enable-auto-commit: false
  producer:
    acks: all
    retries: 3
    batch-size: 16384
    linger-ms: 10

