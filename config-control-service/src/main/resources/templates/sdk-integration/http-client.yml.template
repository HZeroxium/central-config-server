# HTTP Client Configuration Template
# This template provides a common pattern for HTTP client configuration

http:
  client:
    timeout:
      connect: 5000
      read: 10000
      write: 10000
    pool:
      max-connections: 100
      max-connections-per-route: 20
    retry:
      max-attempts: 3
      backoff-delay: 1000

