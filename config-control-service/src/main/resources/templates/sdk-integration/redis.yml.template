# Redis Configuration Template
# This template provides a common pattern for Redis configuration

redis:
  host: ${REDIS_HOST:localhost}
  port: ${REDIS_PORT:6379}
  password: ${REDIS_PASSWORD:}
  database: 0
  timeout: 2000
  pool:
    max-active: 8
    max-idle: 8
    min-idle: 0

