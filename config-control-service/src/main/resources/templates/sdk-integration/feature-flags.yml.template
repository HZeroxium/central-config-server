# Feature Flags Configuration Template
# This template provides a common pattern for feature flags configuration

feature-flags:
  enabled: true
  provider: unleash
  unleash:
    api-url: ${UNLEASH_API_URL:http://unleash:4242/api/}
    api-key: ${UNLEASH_API_KEY:}
    environment: ${UNLEASH_ENVIRONMENT:development}
    app-name: ${spring.application.name}
  refresh-interval: 60000

