# Database Configuration Template
# This template provides a common pattern for database configuration using @ConfigurationProperties

database:
  host: ${DB_HOST:localhost}
  port: ${DB_PORT:5432}
  name: ${DB_NAME:mydb}
  username: ${DB_USERNAME:user}
  password: ${DB_PASSWORD:password}
  pool:
    min-size: 5
    max-size: 20
    connection-timeout: 30000

