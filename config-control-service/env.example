# Config Control Service Environment Variables

# Server Configuration
SERVER_PORT=8889

# Spring Profiles
SPRING_PROFILES_ACTIVE=default

# MongoDB Configuration
MONGODB_URI=mongodb://mongodb:27017/config-control

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Consul Configuration
CONSUL_HOST=localhost
CONSUL_PORT=8500

# Application Configuration
ENVIRONMENT=development

# Logging Configuration
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_EXAMPLE_CONTROL=DEBUG

# Config Proxy Mock Mode (for testing/load testing)
# Enable mock mode to avoid GitHub rate limits during testing
CONFIG_PROXY_MOCK_MODE_ENABLED=false
CONFIG_PROXY_MOCK_STRATEGY=DETERMINISTIC
CONFIG_PROXY_STATIC_MOCK_HASH=mock-hash-static-12345
CONFIG_PROXY_LOG_MOCK_USAGE=true

